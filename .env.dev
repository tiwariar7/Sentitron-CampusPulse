QDRANT_HOST=localhost
QDRANT_PORT=6333

REDIS_URL=redis://localhost:6379/0
REDIS_INFERENCE_TTL=3600
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=tiwariar279@gmail.com
