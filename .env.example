# =============================================================
# SENTITRON CAMPUSPULSE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.dev / .env.staging / .env.prod and fill values
# NEVER commit .env.staging or .env.prod to version control
# =============================================================

# ----- Application -----
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ----- Database -----
# Dev: SQLite fallback (no docker needed)
DATABASE_URL=sqlite+aiosqlite:///./campuspulse.db
# Prod: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/campuspulse

# ----- JWT Auth -----
JWT_SECRET_KEY=CHANGE_ME_campuspulse_jwt_secret_32chars_min
JWT_REFRESH_SECRET_KEY=CHANGE_ME_campuspulse_refresh_secret_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Kafka -----
KAFKA_BROKER=localhost:9092        # docker: kafka:9092
KAFKA_CONSUMER_GROUP=campuspulse-workers
KAFKA_TOPIC_COMPLAINTS=complaint.created
KAFKA_TOPIC_CLASSIFIED=complaint.classified
KAFKA_TOPIC_CLUSTERED=complaint.clustered
KAFKA_TOPIC_ESCALATED=complaint.escalated
KAFKA_TOPIC_NOTIFICATION=notification.created
KAFKA_TOPIC_AUDIT=audit.logged
KAFKA_TOPIC_ANALYTICS=analytics.generated
KAFKA_DLQ_PREFIX=dlq

# ----- Qdrant -----
QDRANT_HOST=localhost              # docker: qdrant
QDRANT_PORT=6333

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0 # docker: redis://redis:6379/0
REDIS_INFERENCE_TTL=3600          # seconds
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

# ----- Email / Gmail SMTP -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=tiwariar279@gmail.com
SMTP_PASSWORD=CHANGE_ME_gmail_app_password_16chars
ALERT_EMAIL_FROM=tiwariar279@gmail.com
ALERT_EMAIL_TO=tiwariar279@gmail.com
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY=2          # seconds (exponential: 2, 4, 8)

# ----- Observability -----
PROMETHEUS_PORT=8000              # FastAPI /metrics endpoint
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=campuspulse-backend

# ----- AI Inference -----
INFERENCE_CONFIDENCE_THRESHOLD=0.70
MODEL_CLASSIFIER_VERSION=1.0.0
MODEL_EMBEDDER_VERSION=1.0.0

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ----- Rate Limiting -----
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_ANONYMOUS=10/minute
RATE_LIMIT_GLOBAL=300/minute
